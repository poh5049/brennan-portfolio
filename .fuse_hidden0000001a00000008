          </ul>
        </div>
        <div>
          <h4>Find Me</h4>
          <ul>
            <li><a href="https://www.instagram.com/brennan.sginterior" target="_blank" rel="noopener">Instagram</a></li>
            <li><a href="https://www.tiktok.com/@brennan.sginterior" target="_blank" rel="noopener">TikTok</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© <span id="year">2026</span> Craft with Brennan · SG Interior (SGI Design Lab)</span>
        <span>Site v0.1 · backbone</span>
      </div>
    </div>
  </footer>

  <script src="assets/js/main.js"></script>
